<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit form</title>
</head>
<body>
    <h1>Edit Post</h1>
    <!-- these two no need to edit -->
     <p> post Username:<% post.Username %> </p>
     <p> post id :<% post.id %> </p>
    <!-- we will make a form to edit the post -->
     <!-- we cannot send patch and put req in html form so we
       need to use method-override -->

    <form action="/posts/<%= post.id %>?_method=PATCH" method="post">
        <textarea rows="10" cols="35" name="content"> <% =post.content %> </textarea>
        <br>
        <button type="submit">Update Post</button>
    </form>
    
</body>
</html>